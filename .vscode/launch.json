    "version": "0.2.0",
    "configurations": [
        {
            "name": "Open Schoolchesschat.com",
            "request": "launch",
            "type": "msedge",
            "url": "https://schoolchesschat.com",
            "webRoot": "${workspaceFolder}",
            "noDebug": true
        },
        {
            "name": "Open local chess site",
            "request": "launch",
            "type": "msedge",
            "url": "http://localhost:8000",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "Start local web server",
            "noDebug": true
        }
    ]
}